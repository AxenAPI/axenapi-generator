# Application Configuration
server.port={{serverPort}}
spring.jackson.date-format={{basePackage}}.RFC3339DateFormat
spring.jackson.serialization.WRITE_DATES_AS_TIMESTAMPS=false

{{#useKafka}}
    {{#kafkaBootstrap}}
# kafka configuration
spring.kafka.bootstrap-servers={{kafkaBootstrap}}
    {{/kafkaBootstrap}}
    {{^kafkaBootstrap}}
spring.kafka.bootstrap-servers=localhost:29092
    {{/kafkaBootstrap}}
{{/useKafka}}

{{#useRabbit}}
# rabbitmq configuration
spring.rabbitmq.host={{rabbitHost}}
spring.rabbitmq.port={{rabbitPort}}
spring.rabbitmq.username={{rabbitUsername}}
spring.rabbitmq.password={{rabbitPassword}}
{{/useRabbit}}

